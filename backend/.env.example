# Django Secret Key - Generate a new one for production!
SECRET_KEY=your-secret-key-here

# Debug Mode - Set to False in production
DEBUG=False

# Allowed Hosts - Comma-separated list of allowed domains
# For production, include your domain (e.g., yourapp.onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1,yourapp.onrender.com

# CORS Allowed Origins - Comma-separated list of allowed frontend URLs
# For production, include your frontend domain
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Force HTTPS for OAuth redirects (set to 'http' for local dev only)
ACCOUNT_DEFAULT_HTTP_PROTOCOL=https

# Database Configuration
# For Render PostgreSQL, use: django.db.backends.postgresql
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Google OAuth Credentials (Get these from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Email Configuration (for lead request notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@flown.com
ADMIN_EMAIL=admin@flown.com

# Zoom Server-to-Server OAuth Credentials (Get these from Zoom Marketplace)
ZOOM_ACCOUNT_ID=your-zoom-account-id
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret

# Legacy Zoom API Credentials (Deprecated, mapped automatically to Client ID/Secret if above is empty)
ZOOM_API_KEY=
ZOOM_API_SECRET=
